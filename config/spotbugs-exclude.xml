<FindBugsFilter>
  <!-- Spring services intentionally retain container-owned collaborators. Domain payloads are not excluded. -->
  <Match>
    <Class name="~io\.durableflow\.(persistence|api|scheduler|worker)\..*"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
