{"title":"DurableFlow","uid":"durableflow","schemaVersion":39,"version":1,"panels":[{"id":1,"title":"Ready queue (global database gauge)","type":"timeseries","gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"max(durableflow_queue_depth{status=\"READY\"})"}]},{"id":2,"title":"Task completions by status","type":"timeseries","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum by(status)(rate(durableflow_tasks_completed_total[5m]))"}]},{"id":3,"title":"p95 scheduling latency","type":"timeseries","gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"histogram_quantile(0.95,sum by(le)(rate(durableflow_scheduling_latency_seconds_bucket[5m])))"}]},{"id":4,"title":"Lease expirations","type":"timeseries","gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum(rate(durableflow_lease_expirations_total[5m]))"}]}]}
